#!/usr/bin/env python3
"""librespot --onevent handler. Writes current track info to nowplaying.json."""
import json
import os
from datetime import datetime
from pathlib import Path

# Derive data dir from PCS_CONFIG so this works for both "spotpi" and
# "pi-connect-speaker" installs, each of which has PrivateTmp=true in
# their systemd units — /tmp is private and not shared between services.
_config = os.environ.get("PCS_CONFIG", "/etc/spotpi/config.toml")
_service_dir = Path(_config).parent.name  # e.g. "spotpi" or "pi-connect-speaker"
_data_dir = Path(f"/var/lib/{_service_dir}")
_data_dir.mkdir(parents=True, exist_ok=True)
NOWPLAYING = _data_dir / "nowplaying.json"
event = os.environ.get("PLAYER_EVENT", "")


def now():
    return datetime.now().isoformat()


if event in ("changed", "started"):
    # Full metadata is available on changed/started events.
    covers = os.environ.get("COVERS", "")
    cover_url = covers.split()[0] if covers.strip() else ""
    NOWPLAYING.write_text(json.dumps({
        "event": event,
        "name": os.environ.get("NAME", ""),
        "artists": os.environ.get("ARTISTS", ""),
        "album": os.environ.get("ALBUM", ""),
        "track_id": os.environ.get("TRACK_ID", ""),
        "duration_ms": int(os.environ.get("DURATION_MS", "0") or "0"),
        "position_ms": int(os.environ.get("POSITION_MS", "0") or "0"),
        "cover_url": cover_url,
        "ts": now(),
    }))
elif event == "playing":
    # librespot 0.8+ fires "playing" without track metadata.
    # Keep existing metadata only when the track_id hasn't changed.
    # If the track changed, write empty metadata so the web server's
    # journal fallback can fill in the correct name.
    new_id = os.environ.get("TRACK_ID", "")
    existing: dict = {}
    if NOWPLAYING.exists():
        try:
            existing = json.loads(NOWPLAYING.read_text())
        except Exception:
            pass
    same_track = new_id and new_id == existing.get("track_id", "")
    NOWPLAYING.write_text(json.dumps({
        "event": "playing",
        "name":      existing.get("name", "")    if same_track else "",
        "artists":   existing.get("artists", "") if same_track else "",
        "album":     existing.get("album", "")   if same_track else "",
        "cover_url": existing.get("cover_url", "") if same_track else "",
        "track_id": new_id or existing.get("track_id", ""),
        "duration_ms": int(os.environ.get("DURATION_MS", "0") or "0"),
        "position_ms": int(os.environ.get("POSITION_MS", "0") or "0"),
        "ts": now(),
    }))
elif event == "paused":
    if NOWPLAYING.exists():
        try:
            data = json.loads(NOWPLAYING.read_text())
            data["event"] = "paused"
            NOWPLAYING.write_text(json.dumps(data))
        except Exception:
            pass
elif event in ("stopped", "session_disconnected"):
    NOWPLAYING.write_text(json.dumps({"event": event, "ts": now()}))
